# ==============================================================================
# MarketGapAnalysis & IdeaValidation - 環境変数テンプレート (.env.example)
#
# 【設定手順】
# 1. 本ファイルを `.env.local` にコピーしてください:
#    cp .env.example .env.local
# 2. 各サービスの実際のキー／トークンを記述してください。
# ※ 本ファイルに実際のAPIキーや機密情報は絶対に記述・コミットしないでください。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase 設定
# ------------------------------------------------------------------------------
# Supabase プロジェクト URL (例: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase 公開 Anon Key (クライアント・ブラウザ用)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (サーバーサイド管理者権限用 - 外部流出厳禁)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. Google AI Studio (Gemini API)
# ------------------------------------------------------------------------------
# Gemini API Key (Gemini 2.5 / 1.5 Pro / Flash 用)
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 3. Tavily API (Web 検索・リアルタイム市場調査)
# ------------------------------------------------------------------------------
# Tavily Search API Key
TAVILY_API_KEY=tvly-...

# ------------------------------------------------------------------------------
# 4. GitHub API (オープンソース死骸検索・リポジトリ調査)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (classic または fine-grained)
GITHUB_ACCESS_TOKEN=ghp_...

# ------------------------------------------------------------------------------
# 5. Product Hunt API (新興プロダクト・ランキング取得)
# ------------------------------------------------------------------------------
# Product Hunt Developer Token
PRODUCT_HUNT_API_TOKEN=...

# ------------------------------------------------------------------------------
# 6. Inngest 設定 (非同期パイプライン・バックグラウンドジョブ)
# ------------------------------------------------------------------------------
# Inngest Event Key (ローカル開発時はダミーまたは dev key で可)
INNGEST_EVENT_KEY=test-inngest-event-key

# Inngest Signing Key (ローカル開発時は test- プレフィックスで dev モード動作)
INNGEST_SIGNING_KEY=test-inngest-signing-key

# ------------------------------------------------------------------------------
# 7. Stripe 設定 (ハイブリッド課金・クレジット購入・サブスクリプション)
# ------------------------------------------------------------------------------
# Stripe Secret API Key (本番: sk_live_..., テスト: sk_test_...)
STRIPE_SECRET_KEY=sk_test_...

# Stripe Webhook Signing Secret (本番: whsec_..., Stripe CLI: whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 8. 本番用ドメイン & OAuth コールバック設定
# ------------------------------------------------------------------------------
# アプリケーションのベースURL (本番: https://your-production-domain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
